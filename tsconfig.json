{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./frontend/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "frontend/app/**/*.ts",
    "frontend/app/**/*.tsx",
    "frontend/components/**/*.tsx",
    "frontend/hooks/**/*.ts",
    "frontend/lib/**/*.ts",
    "prisma/seed.ts",
    "frontend/vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend/dist"
  ]
}
