# Copy to .env and supply local values. Never commit .env.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/codegrove"
# Needed only for prisma migrate dev. This must be a DIFFERENT database.
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/codegrove_shadow"
PORT=3001
HOST=127.0.0.1
APP_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001"
NODE_ENV=development
SESSION_DAYS=7
# Use 1 only when the app is behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# Integration and browser acceptance tests: use a separate database ending in _test.
TEST_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/codegrove_test"
