{
  "name": "codegrove",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "dev:server": "node --watch --env-file=.env backend/server.js",
    "build": "tsc --noEmit && vite build --config frontend/vite.config.ts",
    "start": "node --env-file=.env backend/server.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:check": "node --env-file=.env scripts/check-db.mjs",
    "db:import": "node --env-file=.env scripts/import-legacy.mjs",
    "db:link-user": "node --env-file=.env scripts/link-legacy-user.mjs",
    "test": "node --import tsx --test tests/unit.test.mjs tests/routes.test.tsx tests/google.test.mjs",
    "test:integration": "node --env-file=.env --test tests/integration.test.mjs",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed --project=desktop-chromium",
    "test:browser:list": "playwright test --list",
    "test:browser:types": "tsc --noEmit -p tsconfig.browser.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "6.19.3",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cookie-parser": "1.4.7",
    "date-fns": "^4.4.0",
    "dotenv": "16.6.1",
    "embla-carousel-react": "^8.6.0",
    "express": "5.1.0",
    "express-rate-limit": "8.2.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "openid-client": "6.8.8",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "prisma": "6.19.3",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
